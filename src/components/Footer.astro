---
/**
 * The site footer.
 *
 * IT NO LONGER CARRIES THE ESTATE LINKS. It used to, on every page, and the
 * paragraph that used to sit here argued for it. That argument was wrong and
 * the reasoning is at the removal site below.
*/
import Wordmark from "./Wordmark.astro";
import { site } from "../lib/site";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid">
      <div>
        <div style="font-size: var(--step-2); margin-bottom: var(--space-4);">
          <Wordmark href={null} />
        </div>
        <p style="max-width: 34ch; color: var(--ink-soft);">{site.tagline}</p>
      </div>

      <nav aria-labelledby="footer-site">
        <h2 id="footer-site">This site</h2>
        <ul>
          <li><a href="/articles/">All articles</a></li>
          <li><a href="/about/">About and author</a></li>
          <li><a href="/disclaimer/">What this site is not</a></li>
          <li><a href="/sitemap-index.xml">Sitemap</a></li>
        </ul>
      </nav>

      {/* THE ESTATE BLOCK IS GONE FROM THE FOOTER, DELIBERATELY, 2026-08-26.

         It rendered all four sibling domains as anchors on EVERY page. At the
         planned 365 articles that is roughly 1,480 sitewide cross-domain links
         between five domains owned by one person, three of them deep links to
         the siblings' own person pages.

         That is a link scheme footprint. Google's spam policies name PBNs and
         excessive reciprocal linking explicitly, and a manual action lands in
         Search Console, can hit the linked sites rather than only this one, and
         takes a reconsideration request and months to clear. The owner of these
         domains is in the middle of a reputational problem with his own name.
         He is the last person who can afford to look like he runs a network.

         The estate links now live on /about/ ONLY, where a reader who wants to
         know who wrote this goes looking, and where a single set of links is
         editorial rather than structural. scripts/verify-schema.mjs fails the
         build if a sibling host appears in an anchor on more than one route.

         Do not restore this. The reasoning is not aesthetic. */}
    </div>

    <p class="site-footer__colophon">
      <span>&copy; {year} ISM50</span>
      <span>Published from Ottawa, Ontario</span>
      <span>History, not advice</span>
    </p>
  </div>
</footer>
